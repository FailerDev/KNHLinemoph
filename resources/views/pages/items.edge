                             onchange="Items.setResultMode('rows')">
                      <label class="btn btn-outline-secondary btn-sm" for="modeRows">หลายแถว → ตาราง Flex</label>
                    </div>

                    <div id="modeHintSingle" class="form-text" style="font-size:11px;">
                      SQL คืนแถวเดียว แต่ละคอลัมน์ใช้เป็น <code>&#123;ชื่อคอลัมน์&#125;</code> ในเทมเพลตได้โดยตรง
                    </div>

                    <div id="joinedModeWrap" hidden>
                      <div class="row g-2 mt-1">
                        <div class="col-md-9">
                          <label class="form-label" style="font-size:12px;">Row Template * <span class="text-muted-soft">(ใช้ &#123;ชื่อคอลัมน์&#125; ได้)</span></label>
                          <textarea class="form-control" name="row_template" rows="3"
                            style="font-family:ui-monospace,monospace;font-size:12px;"
