@component('layouts/auth', { title: 'เข้าสู่ระบบ' })
  @slot('main')
    <div class="auth-shell">
      <div class="auth-card">
        <div class="auth-brand">
          <span class="auth-logo"><i class="bi bi-chat-dots-fill" aria-hidden="true"></i></span>
          <h1>{{ siteTitle || appName() }}</h1>
          <small>{{ orgName }}</small>
        </div>

        @if(typeof error !== 'undefined' && error)
          <div class="alert alert-danger" role="alert" style="margin-bottom:16px;">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i> {{ error }}
          </div>
        @end

        <form method="POST" action="/login" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          <div class="mb-3">
            <label for="username" class="form-label">ชื่อผู้ใช้</label>
            <div class="input-icon">
              <i class="bi bi-person" aria-hidden="true"></i>
              <input type="text" id="username" name="username" value="{{ username ?? '' }}"
                     required autofocus autocomplete="username" class="form-control" placeholder="กรอกชื่อผู้ใช้">
            </div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">รหัสผ่าน</label>
            <div class="input-icon">
              <i class="bi bi-lock" aria-hidden="true"></i>
              <input type="password" id="password" name="password" required
                     autocomplete="current-password" class="form-control" placeholder="กรอกรหัสผ่าน">
            </div>
          </div>

          <button type="submit" class="btn-modern btn-brand">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> เข้าสู่ระบบ
          </button>
        </form>

        <div class="auth-foot">v{{ appVersion }} · FailerDev</div>
      </div>
    </div>
  @end
@end
